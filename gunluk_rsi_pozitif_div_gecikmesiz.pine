//@version=6
indicator("Günlük RSI Pozitif Diverjans — 30+ Tetik", shorttitle="D RSI Bull 30+", overlay=false, timeframe="D", timeframe_gaps=true)

// Bu gösterge yalnızca günlük mumlar için çalışır. Sinyal, geçmişe offset
// verilmeden RSI 30'u yukarı kestiği anda üretilir (mum kapanışında).
rsiLength = input.int(14, "RSI uzunluğu", minval=1, group="RSI")
rsiSource = input.source(close, "Kaynak", group="RSI")
oversold = input.float(30.0, "Aşırı satım / tetik seviyesi", minval=1, maxval=50, step=0.1, group="Kurallar")
maxBarsBetweenLows = input.int(60, "İki dip arasındaki en çok mum", minval=2, group="Kurallar")
showCandidate = input.bool(true, "30 altındaki aday diverjansı göster", group="Görünüm")

rsi = ta.rsi(rsiSource, rsiLength)
plot(rsi, "RSI", color=#7E57C2)
upper = hline(70, "70", color=#787B86)
mid = hline(50, "50", color=color.new(#787B86, 50))
lower = hline(oversold, "30", color=#787B86)
fill(upper, lower, color=color.rgb(126, 87, 194, 90), title="RSI bölgesi")

// Sağ taraftan pivot beklememek için dip, RSI'nın önceki mumdan yükselmeye
// başladığı ilk mumda tespit edilir. Bu, klasik ta.pivotlow(..., right=5)
// yaklaşımındaki 5 mumluk bildirimi ortadan kaldırır; karşılığında aday dip
// daha erken tespit edildiği için mum kapandıktan sonra değişmez.
turningUp = bar_index >= 2 and rsi[1] <= rsi[2] and rsi > rsi[1]
newRsiLow = rsi[1]
newPriceLow = low[1]
newLowBar = bar_index - 1

var float firstRsiLow = na
var float firstPriceLow = na
var int firstLowBar = na
var bool bullishCandidate = false

// Yeni bir aşırı satım dalgası başlat.
if ta.crossunder(rsi, oversold)
    firstRsiLow := na
    firstPriceLow := na
    firstLowBar := na
    bullishCandidate := false

// İlk 30-altı RSI dibi saklanır. Sonraki 30-altı dipte fiyat daha düşük,
// RSI daha yüksekse pozitif diverjans adayı oluşur.
if turningUp and newRsiLow < oversold
    if na(firstRsiLow)
        firstRsiLow := newRsiLow
        firstPriceLow := newPriceLow
        firstLowBar := newLowBar
    else
        barsApart = newLowBar - firstLowBar
        isBullish = barsApart <= maxBarsBetweenLows and newPriceLow < firstPriceLow and newRsiLow > firstRsiLow
        if isBullish
            bullishCandidate := true
        // En son RSI dibi, bir sonraki karşılaştırma için referans olur.
        firstRsiLow := newRsiLow
        firstPriceLow := newPriceLow
        firstLowBar := newLowBar

// Gecikmesiz kullanım: sinyal, teyit edilmiş aday varken RSI 30'u yukarı
// geçtiği gün üretilir. İşaret geçmişteki dibe taşınmaz ve repaint etmez.
bullishSignal = bullishCandidate and ta.crossover(rsi, oversold)

plotshape(showCandidate and bullishCandidate and rsi < oversold ? rsi : na,
     title="Pozitif diverjans adayı", text="DIV", style=shape.circle,
     location=location.absolute, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(bullishSignal ? rsi : na,
     title="RSI 30+ Pozitif Diverjans", text="BULL 30+", style=shape.labelup,
     location=location.absolute, color=color.green, textcolor=color.white, size=size.small)

alertcondition(bullishSignal, title="Günlük RSI 30+ Pozitif Diverjans", message="{{ticker}}: Günlük grafikte fiyat daha düşük dip, RSI daha yüksek dip yaptı; RSI 30'u yukarı kesti.")

